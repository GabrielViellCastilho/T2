// schema.prisma

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Continente {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String
  paises      Pais[]
}

model Pais {
  id             Int       @id @default(autoincrement())
  nome           String
  populacao      Int
  idiomaOficial  String
  moeda          String
  continenteId   Int
  continente     Continente @relation(fields: [continenteId], references: [id])
  cidades        Cidade[]
  url_bandeira   String?    @db.VarChar(255)
  pib_per_capita Decimal?   @db.Decimal(15,2)
  inflacao       Decimal?   @db.Decimal(5,2)  
}


model Cidade {
  id           Int      @id @default(autoincrement())
  nome         String
  populacao    Int
  latitude     Float
  longitude    Float
  paisId       Int
  pais         Pais     @relation(fields: [paisId], references: [id])
}
